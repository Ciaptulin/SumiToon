  "licensesUrl": "https://github.com/Ciaptulin/SumiToon/blob/master/LICENSE",
  "keywords": [
    "toon",
    "npr",
    "cel-shading",
    "urp",
    "shader",
    "outline",
    "anime"
  ],
  "author": {
    "name": "SumiToon",
    "url": "https://github.com/SumiToon"
  },
  "dependencies": {
    "com.unity.render-pipelines.universal": "16.0.6",
    "com.alefeng.outlinesmoothnormalsgenerator": "1.8.1"
  },
  "testables": [
    "SumiToon.Tests.EditMode"
  ],
  "samples": [
    {
      "displayName": "Demo",
