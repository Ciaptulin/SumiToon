# ============================================================
# Unity 标准 .gitignore
# 参考：https://github.com/github/gitignore/blob/main/Unity.gitignore
# ============================================================

# ---- Unity 自动生成 ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# ---- IDE 自动生成 ----
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---- 构建产物 ----
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# ---- 临时/备份文件 ----
*.bak
*.tmp
*.swp
*~
# 例外：UPM 规范的文档目录（~ 后缀表示 Unity 不导入）
!Document~/
!Document~/**
.DS_Store
Thumbs.db

# ---- 错误副本（不进版本控制）----
/SumiToon_root_duplicates_backup/

# ---- 日志 ----
*.log
